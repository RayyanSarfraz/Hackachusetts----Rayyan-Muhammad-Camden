# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@db:5432/config
POSTGRES_DB=config
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# AI model service (MedGemma served via vLLM, OpenAI-compatible /v1 endpoint).
# Base URL should end in /v1. Leave MODEL_API_BASE_URL empty to run with the
# model service "unavailable" (the engine degrades gracefully and never
# fabricates medical facts). Put the real token only in .env (gitignored).
MODEL_API_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=google/medgemma-1.5-4b-it

# Vector store (ChromaDB, local persistent client — not the networked server).
CHROMA_PERSIST_DIR=.chroma
CHROMA_COLLECTION=clinical_trials
