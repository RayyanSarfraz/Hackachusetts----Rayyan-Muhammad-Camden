# Root compose environment. Copy to .env and adjust for your machine.
# docker compose automatically reads a .env file in this directory.

# PostgreSQL
POSTGRES_DB=config
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Django
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI model service (fine-tuned Qwen via vLLM, OpenAI-compatible /v1).
# Empty MODEL_API_BASE_URL => engine runs with model "unavailable".
MODEL_API_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=qwen

# Vector store (ChromaDB, local persistent client).
CHROMA_PERSIST_DIR=.chroma
CHROMA_COLLECTION=clinical_trials
